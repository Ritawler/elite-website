# Supabase project connection — copy this file to .env.local and fill in
# real values. Never commit .env.local (it's already in .gitignore).

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# IMPORTANT: use the "legacy" JWT anon key, not the newer "publishable" key.
# Find it at Supabase Dashboard -> Project Settings -> API -> Project API keys
# -> "anon" / "public" (a long JWT starting with "eyJ...").
# The newer key format (sb_publishable_...) caused "Invalid API key" errors
# with the @supabase/ssr version used in this project.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-legacy-anon-jwt-key
