# Supabase project connection — copy this file to .env.local and fill in
# real values. Never commit .env.local (it's already in .gitignore).

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# IMPORTANT: use the "legacy" JWT anon key, not the newer "publishable" key.
# Find it at Supabase Dashboard -> Project Settings -> API -> Project API keys
# -> "anon" / "public" (a long JWT starting with "eyJ...").
# The newer key format (sb_publishable_...) caused "Invalid API key" errors
# with the @supabase/ssr version used in this project.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-legacy-anon-jwt-key

# Service role key — bypasses RLS entirely. NEVER prefix with NEXT_PUBLIC_,
# never import it into a Client Component. Used only by lib/supabase/admin.js
# to confirm payments from the UPayments webhook, which has no user session
# to authenticate a normal request with.
# Find it at Supabase Dashboard -> Project Settings -> API -> Project API
# keys -> "service_role" (a long JWT — different from the anon key above).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-jwt-key

# UPayments — Bearer token used server-side only (lib/upayments.js).
# Find it in your UPayments merchant dashboard / API credentials page.
# Use the Sandbox key + sandboxapi.upayments.com while testing; switch both
# to the Live key + uapi.upayments.com only when ready to accept real money.
UPAYMENTS_API_KEY=your-upayments-bearer-token
UPAYMENTS_BASE_URL=https://sandboxapi.upayments.com/api/v1

# Set to "true" to fake all UPayments calls locally (no real API calls at
# all) so the rest of the purchase flow can be tested before a real
# Sandbox key exists. Set to "false" once testing against the real API.
UPAYMENTS_MOCK_MODE=true
